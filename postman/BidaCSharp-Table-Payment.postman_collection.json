{
  "info": {
    "_postman_id": "5e6c6d43-5bd0-47a8-b475-7f2748c19d79",
    "name": "BidaCSharp - Test ngan gon",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5289" },
    { "key": "token", "value": "" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "admin123" },
    { "key": "table_id", "value": "" },
    { "key": "session_id", "value": "" }
  ],
  "item": [
    {
      "name": "Bo 8 test",
      "item": [
        {
          "name": "1. Dang nhap admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/api/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login success 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Lay danh sach ban",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tables list 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Tao ban thanh cong",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ban Word\",\n  \"type\": \"standard\",\n  \"price_per_hour\": 60000,\n  \"position_order\": 1\n}"
            },
            "url": "{{base_url}}/api/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create table 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('table_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Tao ban thieu ten",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"type\": \"standard\",\n  \"price_per_hour\": 60000,\n  \"position_order\": 2\n}"
            },
            "url": "{{base_url}}/api/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create table missing name 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Bat dau phien choi",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_id\": {{table_id}}\n}"
            },
            "url": "{{base_url}}/api/start-session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('start session 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('session_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Thanh toan thanh cong",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": {{session_id}},\n  \"payment_method\": \"cash\"\n}"
            },
            "url": "{{base_url}}/api/payment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payment success 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Thanh toan thieu session_id",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_method\": \"cash\"\n}"
            },
            "url": "{{base_url}}/api/payment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payment missing session 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Xoa ban khong ton tai",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/tables/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete table not found 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
